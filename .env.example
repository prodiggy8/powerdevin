DATABASE_URL=postgres://powerdevin:powerdevin@localhost:5432/powerdevin

# Integration tests only; the database is created by the test setup
DATABASE_URL_TEST=postgres://powerdevin:powerdevin@localhost:5432/powerdevin_test

# openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra ID (Azure AD) app registration
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Issuer for a registration limited to "Personal Microsoft accounts only" (the demo setup).
# This is the fixed tenant id of the Microsoft consumer directory; /common and /consumers both fail
# for that registration type (see README, "Microsoft Entra ID setup").
# Work + personal registration: https://login.microsoftonline.com/common/v2.0
# Production, single tenant:    https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0

# First user matching this email is created as an admin, everyone else as analyst
SEED_ADMIN_EMAIL=gustavogabrielp@hotmail.com
